# Copy to .env on the server. Never commit .env.
POSTGRES_PASSWORD=change-me-long-random
# Leave unset to use the bundled Postgres; set to a Neon/Supabase URL to move state off-box.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
TUNNEL_TOKEN=
NOBG_CORS_ORIGINS=https://nobg.here,https://www.nobg.here,http://localhost:3000
NOBG_MAX_CONCURRENCY=2
NOBG_MAX_WAITING=6
NOBG_THREADS=4
NOBG_MAX_MP=16
NOBG_MAX_UPLOAD_MB=25
NOBG_WEB_PER_MIN=8
NOBG_WEB_PER_DAY=60
